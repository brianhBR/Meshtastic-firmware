{
  // === WisMesh Pocket V2 (RAK4631) recovery base station ===
  // OLED-friendly settings: text-only boot screen (no XBM image -- 128x64 is too small for the 104x88 logo)

  // === Channel 0: "doris" (same as T-Echo) ===
  "USERPREFS_CHANNEL_0_NAME": "doris",
  "USERPREFS_CHANNEL_0_PSK": "{ 0x9d, 0x98, 0xcd, 0x61, 0x66, 0xf6, 0x4e, 0xdf, 0xa3, 0x03, 0xea, 0x07, 0x5c, 0x2d, 0xae, 0x2f, 0x56, 0xdc, 0x53, 0x3b, 0x40, 0x9b, 0x77, 0x83, 0x3f, 0x9b, 0xc2, 0xfc, 0x5f, 0x2f, 0x06, 0x70 }",
  "USERPREFS_CHANNEL_0_PRECISION": "32",
  "USERPREFS_CHANNEL_0_UPLINK_ENABLED": "false",
  "USERPREFS_CHANNEL_0_DOWNLINK_ENABLED": "false",

  // === LoRa Settings (same as T-Echo) ===
  "USERPREFS_CONFIG_LORA_REGION": "meshtastic_Config_LoRaConfig_RegionCode_US",
  "USERPREFS_LORACONFIG_MODEM_PRESET": "meshtastic_Config_LoRaConfig_ModemPreset_LONG_FAST",

  // === Device ===
  "USERPREFS_CONFIG_DEVICE_ROLE": "meshtastic_Config_DeviceConfig_Role_CLIENT",
  "USERPREFS_CONFIG_OWNER_LONG_NAME": "Pocket-%04x",

  // === GPS & Position ===
  // Local fix at 1 Hz so bearing/range to Doris stays live (anything <= 10s
  // keeps the GPS always-on, no soft-sleep). Over-the-air position updates
  // remain at 900s -- smart-position will throttle them further as needed.
  "USERPREFS_CONFIG_GPS_MODE": "meshtastic_Config_PositionConfig_GpsMode_ENABLED",
  "USERPREFS_CONFIG_SMART_POSITION_ENABLED": "true",
  "USERPREFS_CONFIG_GPS_UPDATE_INTERVAL": "1",
  "USERPREFS_CONFIG_POSITION_BROADCAST_INTERVAL": "900",

  // === Bluetooth ===
  "USERPREFS_FIXED_BLUETOOTH": "123456",

  // === Timezone ===
  "USERPREFS_TZ_STRING": "PST8PDT,M3.2.0/2:00:00,M11.1.0/2:00:00       ",

  // === OEM Boot Screen (text-only for 128x64 OLED) ===
  "USERPREFS_OEM_TEXT": "DORIS",
  "USERPREFS_OEM_FONT_SIZE": "2",

  // === Ringtone ===
  "USERPREFS_RINGTONE_RTTTL": "24:d=32,o=5,b=565:f6,p,f6,4p,p,f6,p,f6,2p,p,b6,p,b6,p,b6,p,b6,p,b,p,b,p,b,p,b,p,b,p,b,p,b,p,b,1p.,2p.,p"
}
